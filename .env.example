# Copiá este archivo a .env y completá con tu API key real.
# Por defecto está configurado para Groq (gratis, sin tarjeta).

LLM_API_KEY=tu_api_key_de_groq_aca
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Opcional, Render lo setea solo
PORT=3000

# --- Alternativa: si en algun momento conseguis el credito de Nebius Token Factory ---
# LLM_API_KEY=tu_api_key_de_nebius
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
